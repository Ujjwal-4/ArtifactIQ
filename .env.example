# Copy to .env (or set in your shell) before starting the app.
# Nothing below is secret by default; you SHOULD set your own SECRET_KEY.

# --- required in practice ---------------------------------------------------
# Flask session signing key. If unset, a random key is generated at startup,
# which invalidates sessions on every restart.
ARTIFACTIQ_SECRET_KEY=change-me-to-a-long-random-string

# --- data location ----------------------------------------------------------
# Root for: artifactiq.db, evidence store, reports, logs, exports.
# Default: ./artifactiq/instance (created on first run).
#ARTIFACTIQ_DATA_DIR=D:\aiq_data

# --- server binding (keep loopback; do NOT expose to a network) --------------
#ARTIFACTIQ_HOST=127.0.0.1
#ARTIFACTIQ_PORT=5555
#ARTIFACTIQ_DEBUG=0

# --- limits -----------------------------------------------------------------
#ARTIFACTIQ_MAX_UPLOAD_MB=2048
#ARTIFACTIQ_PARSER_TIMEOUT_S=300
#ARTIFACTIQ_MAX_EVENTS=200000

# --- capabilities (leave off unless you need them) ---------------------------
# 1 = enable the live-acquisition workbench ( Targeted Tools / Live
# Acquisition pages ). Off (0) = pure offline analysis.
#ARTIFACTIQ_ALLOW_LIVE=0

# 1 = enable the optional remote LLM assistant on the Explanation tab.
# Requires ARTIFACTIQ_LLM_URL; only derived narrative text is ever sent.
#ARTIFACTIQ_LLM_ENABLED=0
#ARTIFACTIQ_LLM_URL=

# --- testing knobs -----------------------------------------------------------
#ARTIFACTIQ_CSRF=1          # CSRF protection on state-changing requests (default 1)
